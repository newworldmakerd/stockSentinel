POSTGRES_DB=stocksentinel
POSTGRES_USER=stocksentinel
# Supply passwords and keys via your shell or secret manager; never commit them.
POSTGRES_PORT=5432
JAVA_PORT=8080
PYTHON_PORT=8000
LLM_ENABLED=false
LLM_BASE_URL=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=30
# Secret values must be supplied through environment variables only:
# POSTGRES_PASSWORD
# LLM_API_KEY
# DEEPSEEK_API_KEY (fallback when LLM_API_KEY is not configured)
WECOM_ENABLED=false
WECOM_MODE=SMART_BOT
WECOM_CHAT_ID=
# WECOM_BOT_ID
# WECOM_BOT_SECRET

MARKET_ENABLED=false
MARKET_PROVIDER_ENABLED=false
PYTHON_URL=http://127.0.0.1:8000
JOBS_ENABLED=false
DAILY_SCAN_SCHEDULE_ENABLED=false
INTRADAY_ENABLED=false
INTRADAY_SCHEDULE_ENABLED=false
WECOM_COMMANDS_ENABLED=false
WECOM_COMMANDS_BASE_URL=https://api.deepseek.com
WECOM_COMMANDS_MODEL=deepseek-flash
MARKET_MINUTE_MIRROR_ENABLED=false
MARKET_TENCENT_BACKUP_ENABLED=false
MINUTE_HTTP_TIMEOUT_SECONDS=25
DAILY_REPORT_ENABLED=false
DAILY_REPORT_SCHEDULE_ENABLED=false
DAILY_REPORT_WORKER_ENABLED=true
SCREENING_ENABLED=false
SCREENING_LLM_ENABLED=false
